# =====================================================================
# Universal .gitignore — Orbix / Claude-Code workspace
# Generated by Claude for local-git workflow. Safe across Node, Python,
# Rust, Java, Go, Tauri, and static-site projects. Edit per-project as
# needed.
# =====================================================================

# --- Dependencies ---
node_modules/
bower_components/
jspm_packages/
.pnp/
.pnp.js
.yarn/cache
.yarn/install-state.gz

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.conda/
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# --- Rust / Cargo ---
target/
**/*.rs.bk
Cargo.lock.bak

# --- Java / Gradle / Maven ---
.gradle/
.mvn/
*.class
*.jar
*.war

# --- Go ---
vendor/
*.exe~

# --- Build outputs ---
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
.turbo/
.parcel-cache/
.vite/
.cache/
*.tsbuildinfo

# --- Tauri ---
src-tauri/target/
src-tauri/Cargo.lock

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Environment & Secrets ---
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
*.local.env
*.pem
*.key
*.pfx
*.p12
*.private
*.secret
secrets.json
credentials.json
CREDENTIALS
CREDENTIALS.*
credentials
credentials.*
secrets/
.secrets/

# --- OS junk ---
.DS_Store
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# --- Editor / IDE ---
.idea/
*.iml
*.swp
*.swo
*.swn
.vscode/*.log
.history/
*.sublime-workspace
*.sublime-project

# --- Temp ---
tmp/
.tmp/
*.tmp
*.bak
*.old
*.orig

# --- Misc ---
.cache
.parcel-cache
.serverless/
.firebase/
.vercel
.netlify

.superpowers/
